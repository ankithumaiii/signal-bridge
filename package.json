{
  "name": "signal-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Signal Bridge - Offline-Aware Emergency Safety and Family Alert Platform",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "npm --prefix server start",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:server": "npm --prefix server test",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
