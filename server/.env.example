# Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/signal_bridge
JWT_SECRET=super_secret_jwt_key_signal_bridge_production_2026
CLIENT_URL=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true

# Real SMS Provider Configuration (India TRAI / DLT Compliant)
# Provider options: msg91 | mock
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SIGBRG
MSG91_TEMPLATE_ID=
SMS_TEST_ALLOWLIST=

# Razorpay Payment Gateway Configuration (India)
# Get Test Keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Business Cloud API Configuration (Graph API)
# Get credentials from: https://developers.facebook.com/apps -> WhatsApp -> API Setup
# Default safe demo mode: set WHATSAPP_ENABLED=true to activate live outbound WhatsApp notifications
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# Template name: in Meta dev test setup, "hello_world" is pre-approved by default.
# For custom production alerts, create and approve "signal_bridge_emergency_alert"
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEST_ALLOWLIST=

